---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { formatPostDate } from '../../lib/date';

interface Props {
    post: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
    const posts = await getCollection('blog');
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
    title={`${post.data.title} — Icarus Murqin`}
    ogTitle={post.data.title}
    description={post.data.summary}
    ogType="article"
>
    <section class="card blog-card">
        <div class="blog-topbar">
            <a href="/blog" class="blog-nav-link" data-seed-nav="/blog">← all posts</a>
            <a href="/rss.xml" class="blog-nav-link">RSS</a>
        </div>
        <article class="post-content">
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-actions">
                <p class="post-meta">{formatPostDate(post.data.date)}</p>
                <button type="button" class="copy-md-btn" data-md-url={`/posts/${post.id}.md`}>
                    copy md
                </button>
            </div>
            <div class="post-body">
                <Content />
            </div>
        </article>
    </section>
</Base>

<script>
    // Raw markdown lives at /posts/<slug>.md (generated by posts/[slug].md.ts),
    // the same URL the pre-Astro site published, so existing links still resolve.
    const btn = document.querySelector<HTMLButtonElement>('.copy-md-btn');
    const url = btn?.dataset['mdUrl'];
    if (btn && url) {
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        btn.addEventListener('click', async () => {
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error(`http ${res.status}`);
                await navigator.clipboard?.writeText(await res.text());
                btn.textContent = 'copied!';
            } catch (err) {
                console.warn('Markdown could not be copied:', err);
                btn.textContent = 'failed';
            }
            clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
                btn.textContent = 'copy md';
            }, 1500);
        });
    }
</script>
