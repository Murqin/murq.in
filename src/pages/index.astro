---
import Base from '../layouts/Base.astro';
import Projects from '../components/Projects.astro';
import { getPosts, postSlug, postUrl } from '../lib/blog';
import { formatPostDate } from '../lib/date';

const [latest] = await getPosts('en');
const latestHref = latest ? postUrl('en', postSlug(latest)) : undefined;
---

<Base
    title="Icarus Murqin"
    description="Icarus Murqin's personal site"
    showVisitorCount={true}
>
    <section class="card hero">
        <button type="button" class="dice-btn" aria-label="Generate a new random theme">
            <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                <circle cx="8.5" cy="8.5" r="1" fill="currentColor"></circle>
                <circle cx="15.5" cy="8.5" r="1" fill="currentColor"></circle>
                <circle cx="12" cy="12" r="1" fill="currentColor"></circle>
                <circle cx="8.5" cy="15.5" r="1" fill="currentColor"></circle>
                <circle cx="15.5" cy="15.5" r="1" fill="currentColor"></circle>
            </svg>
        </button>
        <button type="button" class="seed-star" aria-label="Copy theme seed link">✦</button>
        <img src="/assets/avatar-netrunner.webp" alt="Icarus Murqin" class="avatar" width="96" height="96" />
        <h1>Icarus Murqin</h1>
        <p class="tagline">I'm just randomly surfing the web.</p>

        <div class="section-title">Social Media</div>
        <div class="socials">
            <a href="https://www.instagram.com/murqin/" class="social-icon">Instagram</a>
            <a href="https://steamcommunity.com/id/murqin/" class="social-icon">Steam</a>
            <a href="https://www.youtube.com/@Murqin" class="social-icon">YouTube</a>
            <a href="https://github.com/Murqin" class="social-icon">GitHub</a>
        </div>
    </section>

    <!-- One card: the contact card held a single button and stood half empty beside About. -->
    <section class="card">
        <div class="section-title">About Me</div>
        <p>
            Just a tech hobbyist who spends most of his time playing video games,
            listening to music, watching videos, and casually tinkering with random
            projects.
        </p>
        <button type="button" class="mail-btn" title="Copy email address">
            <svg class="mail-btn-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
            </svg>
            <span class="mail-btn-text">murqin@proton.me</span>
        </button>
    </section>

    <section class="card">
        <div class="section-title">Blog</div>
        <p>Occasional notes on projects, tools, and whatever I'm tinkering with.</p>
        {
            latest && latestHref && (
                <a href={latestHref} class="latest-post" data-seed-nav={latestHref}>
                    <span class="latest-post-label">latest</span>
                    <span class="latest-post-title">{latest.data.title}</span>
                    <span class="latest-post-date">{formatPostDate(latest.data.date, 'en')}</span>
                </a>
            )
        }
        <a href="/blog" class="source-link" data-seed-nav="/blog">all posts →</a>
    </section>

    <section class="card">
        <div class="section-title">My Projects</div>
        <Projects />
    </section>
</Base>
