---
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/blog';
// Imported, not linked from public/: Vite then emits it under /_astro/ with a content hash, so a deploy
// changes its URL and no cache (Cloudflare's included) can pair new HTML with an old stylesheet.
import '../styles/style.css';

interface Props {
    title: string;
    description: string;
    /** Social cards read better without the " — Icarus Murqin" suffix. */
    ogTitle?: string;
    /** Drives og:type — posts are articles, everything else is a website. */
    ogType?: 'website' | 'article';
    /** The visitor counter only lives on the home page. */
    showVisitorCount?: boolean;
    lang?: Lang;
    /** Every language version of this page, the current one included, as hreflang -> path. */
    alternates?: Record<string, string>;
    rssHref?: string;
}

const {
    title,
    description,
    ogTitle = title,
    ogType = 'website',
    showVisitorCount = false,
    lang = 'en',
    alternates = {},
    rssHref = '/rss.xml',
} = Astro.props;

// Absolute URLs: link-preview bots reject relative og:image/og:url values.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/og-image-amethyst.png', Astro.site);
// A lone hreflang tag is meaningless, so they appear only when a translation exists. English is
// the x-default because it is the language the site and the old URLs started with.
const hreflangs = Object.keys(alternates).length > 1 ? Object.entries(alternates) : [];
const xDefault = alternates['en'];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={ogType} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="murq.in — Icarus Murqin's personal site" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-crystal-32.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-crystal-192.png" />
        <link rel="apple-touch-icon" href="/assets/apple-touch-icon-crystal.png" />
        {hreflangs.map(([hreflang, path]) => (
            <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />
        ))}
        {hreflangs.length > 0 && xDefault && (
            <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />
        )}
        <link rel="alternate" type="application/rss+xml" title="murq.in blog" href={rssHref} />
    </head>
    <body>
        <div id="gradient" aria-hidden="true"></div>
        <div id="stars" aria-hidden="true"></div>
        <main class="container">
            <slot />
            <Footer lang={lang} showVisitorCount={showVisitorCount} />
        </main>
        <script>
            import '../scripts/theme';
        </script>
    </body>
</html>
