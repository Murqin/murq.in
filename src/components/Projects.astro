---
import { PROJECTS, type Project, type ProjectStatus } from '../data/projects';
import type { Lang } from '../lib/blog';
import { ui } from '../lib/i18n';

interface Props {
    lang: Lang;
    projects?: Project[];
}

const { lang, projects = PROJECTS } = Astro.props;
const t = ui[lang];
const statusLabel: Record<ProjectStatus, string> = {
    active: t.statusActive,
    wip: t.statusWip,
    archived: t.statusArchived,
};
---

<div class="projects-list">
    {
        projects.map((project) => (
            <div class="project-item">
                <div class="project-header">
                    <span class="project-name">{project.name}</span>
                    <span class={`project-status ${project.status}`}>{statusLabel[project.status]}</span>
                </div>
                <p class="project-desc">{project.description[lang]}</p>
                {(project.tags.length > 0 || project.links.length > 0) && (
                    <div class="project-footer">
                        {project.tags.length > 0 && (
                            <div class="project-tags">
                                {project.tags.map((tag) => (
                                    <span class="project-tag">{tag}</span>
                                ))}
                            </div>
                        )}
                        {project.links.length > 0 && (
                            <div class="project-links">
                                {project.links.map((link) => (
                                    <a
                                        class="project-link-btn bracket"
                                        href={link.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {link.label}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                )}
            </div>
        ))
    }
</div>
