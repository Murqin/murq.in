---
import Base from '../layouts/Base.astro';
import Controls from './Controls.astro';
import Projects from './Projects.astro';
import { PINNED_PROJECTS, PROJECTS } from '../data/projects';
import { PROFILE } from '../data/profile';
import RssLink from './RssLink.astro';
import { LANGS, blogIndexUrl, getPosts, postSlug, postUrl, type Lang } from '../lib/blog';
import { formatPostDate } from '../lib/date';
import { ui } from '../lib/i18n';
import { ogImageUrl } from '../lib/ogPath';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const links = Object.fromEntries(LANGS.map((l) => [l, ui[l].homeUrl]));
const blogHref = blogIndexUrl(lang);
// The newest six; the rest are one click away on the blog page.
const posts = (await getPosts(lang)).slice(0, 6);
// Only pages with no other way in: the blog list and RSS are already one click away from the blog
// page. Sorted by the label people read, so the list stays A to Z in both languages.
const otherPages = [
    { label: t.aiTitle, href: t.aiUrl, desc: t.aiIntro },
    { label: t.nowTitle, href: t.nowUrl, desc: t.nowIntro },
    { label: t.colophonTitle, href: t.colophonUrl, desc: t.colophonIntro },
    { label: t.museumTitle, href: t.museumUrl, desc: t.museumIntro },
].sort((a, b) => a.label.localeCompare(b.label, lang));
---

<Base
    title="Icarus Murqin"
    description={t.homeDescription}
    lang={lang}
    ogImagePath={ogImageUrl(lang, 'home')}
    alternates={links}
    snap={true}
>
    <Controls lang={lang} links={links} />

    <section class="snap-page" id="about-me">
        <div class="snap-hero">
            <img src="/assets/avatar-netrunner.webp" alt="Icarus Murqin" class="avatar" width="96" height="96" />
            <div>
                <h1>{PROFILE.name} <span class="snap-realname">({PROFILE.givenName})</span></h1>
                <p class="tagline">{t.tagline}</p>
            </div>
        </div>
        <div class="snap-socials">
            {PROFILE.socials.map((social) => <a class="bracket" href={social.url}>{social.label}</a>)}
        </div>
        <h2>{t.aboutTitle}</h2>
        <p class="snap-text">{t.about}</p>
        <p class="snap-contact">
            {t.contactMe}
            <button type="button" class="mail-btn" title={t.copyEmail} data-copied={t.copied}>
                <span class="mail-btn-text">{PROFILE.email}</span>
            </button>
        </p>
    </section>

    <section class="snap-page" id="blog">
        <div class="page-head">
            <h2>{t.blogHomeTitle}</h2>
            <RssLink lang={lang} />
        </div>
        <p class="snap-text">{t.blogTeaser}</p>
        <ul class="snap-posts">
            {
                posts.map((post) => {
                    const href = postUrl(lang, postSlug(post));
                    return (
                        <li>
                            <a href={href} data-seed-nav={href}>
                                <span class="snap-post-date">{formatPostDate(post.data.date, lang)}</span>
                                <span>{post.data.title}</span>
                            </a>
                        </li>
                    );
                })
            }
        </ul>
        <a href={blogHref} class="source-link bracket" data-seed-nav={blogHref}>{t.allPostsHome}</a>
    </section>

    <section class="snap-page" id="projects">
        <h2>{t.projectsTitle}</h2>
        <Projects lang={lang} projects={PINNED_PROJECTS} />
        {
            // Until a project is left off the home page, the full list would only repeat it.
            PROJECTS.length > PINNED_PROJECTS.length && (
                <a href={t.projectsUrl} class="source-link bracket" data-seed-nav={t.projectsUrl}>
                    {t.allProjects}
                </a>
            )
        }
    </section>

    <section class="snap-page" id="other-pages">
        <h2>{t.otherTitle}</h2>
        <ul class="snap-other">
            {
                otherPages.map((page) => (
                    <li>
                        <a href={page.href} data-seed-nav={page.href}>
                            <span>{page.label}</span>
                            <span class="snap-other-desc">{page.desc}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
        <!-- An old-web hit counter at the very end of the page, instead of a footer strip. -->
        <p id="visitor-count" class="visitor-counter">{t.visitorPrefix}<span class="count-value">…</span></p>
    </section>

    <script>
        import '../scripts/snap';
    </script>
</Base>
