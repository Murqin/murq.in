---
import Base from '../layouts/Base.astro';
import { blogIndexUrl, type Lang } from '../lib/blog';
import { ui } from '../lib/i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const blog = blogIndexUrl(lang);
---

<Base title={t.notFoundTitle} description={t.notFoundText} lang={lang} here="404">
    <section class="snap-page">
        <a href={t.homeUrl} class="blog-nav-link page-back" data-seed-nav={t.homeUrl}>← murq.in</a>
        <h1 class="snap-title">404</h1>
        <p class="snap-text">{t.notFoundText}</p>
        <ul class="snap-other">
            <li><a href={t.homeUrl} data-seed-nav={t.homeUrl}>murq.in →</a></li>
            <li><a href={blog} data-seed-nav={blog}>{t.blogTitle} →</a></li>
        </ul>
    </section>
</Base>
