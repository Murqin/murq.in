---
import type { Lang } from '../lib/blog';
import { ui } from '../lib/i18n';

// Only what the footer is for: where you are, and on the home page the visitor number. Licences,
// source and how the site is made live on /colophon; a "© year · source · MIT" row is the template
// footer every generated site has.
interface Props {
    lang?: Lang;
    showVisitorCount?: boolean;
    here?: string;
}

const { lang = 'en', showVisitorCount = false, here = '' } = Astro.props;
const t = ui[lang];
---

<footer>
    <div class="footer-box">
        {
            showVisitorCount && (
                <p id="visitor-count" class="visitor-counter">
                    {t.visitorPrefix}<span class="count-value">…</span>
                </p>
            )
        }
        <p class="footer-here">
            <span class="visually-hidden">{t.here} </span>
            <span id="here">{here}</span>
            <span id="here-count" class="here-count" />
        </p>
    </div>
</footer>
