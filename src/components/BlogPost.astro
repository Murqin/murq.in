---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Controls from './Controls.astro';
import RssLink from './RssLink.astro';
import {
    blogIndexUrl,
    getTranslations,
    postLang,
    postSlug,
    postUrl,
    rawPostUrl,
    rssUrl,
    type Lang,
    type Post,
} from '../lib/blog';
import { formatPostDate } from '../lib/date';
import { ui } from '../lib/i18n';
import { ogImageUrl } from '../lib/ogPath';

interface Props {
    post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const slug = postSlug(post);
const t = ui[lang];
const { Content, headings } = await render(post);
// Section headings only; a contents list earns its place on long posts, on a short one it is noise.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 4;
// ~200 words a minute, rounded up so a short post never reads "0 min".
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.ceil(words / 200));
const links: Partial<Record<Lang, string>> = Object.fromEntries(
    Object.keys(await getTranslations(slug)).map((l) => [l, postUrl(l as Lang, slug)])
);
const index = blogIndexUrl(lang);
---

<Base
    title={`${post.data.title} — Icarus Murqin`}
    ogTitle={post.data.title}
    description={post.data.summary}
    ogType="article"
    lang={lang}
    ogImagePath={ogImageUrl(lang, `blog/${slug}`)}
    alternates={links}
    rssHref={rssUrl(lang)}
>
    <Controls lang={lang} links={links} />
    <div class="post-layout">
        <aside class="post-aside">
            <a href={index} class="blog-nav-link" data-seed-nav={index}>{t.allPosts}</a>
            {
                showToc && (
                    <details class="post-toc" open>
                        <summary class="post-toc-title">{t.contents}</summary>
                        <ol>
                            {toc.map((h) => (
                                <li>
                                    <a href={`#${h.slug}`}>{h.text}</a>
                                </li>
                            ))}
                        </ol>
                    </details>
                )
            }
            <div class="post-tools">
                <button
                    type="button"
                    class="copy-md-btn"
                    data-md-url={rawPostUrl(lang, slug)}
                    data-label={t.copyMd}
                    data-label-copied={t.copied}
                    data-label-failed={t.copyFailed}
                    data-summary-prompt={t.summaryPrompt}
                >
                    {t.copyMd}
                </button>
                <RssLink lang={lang} />
            </div>
            <p class="post-license">
                <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer license">
                    {t.postLicense}
                </a>
            </p>
        </aside>
        <article class="post-content">
            {
                post.data.aiAssisted && (
                    <p class="ai-badge">
                        <span class="ai-badge-mark" aria-hidden="true">
                            AI
                        </span>
                        <span>
                            {t.aiNote}{' '}
                            <a class="bracket" href={t.aiUrl} data-seed-nav={t.aiUrl}>
                                {t.aiMore}
                            </a>
                        </span>
                    </p>
                )
            }
            <header class="post-header">
                <h1 class="post-title">{post.data.title}</h1>
                <p class="post-meta">
                    {formatPostDate(post.data.date, lang)}
                    <span aria-hidden="true"> · </span>
                    {t.readingTime.replace('{n}', String(minutes))}
                </p>
            </header>
            <div class="post-body">
                <Content />
            </div>
            <nav class="post-end">
                <a href={index} class="blog-nav-link" data-seed-nav={index}>{t.allPosts}</a>
            </nav>
        </article>
    </div>
</Base>

<script>
    // The contents list is open in the desktop side column; on a phone it sits above the text, where an
    // open eleven-item list pushes the post to the second screen.
    if (window.matchMedia('(max-width: 860px)').matches) {
        document.querySelector('details.post-toc')?.removeAttribute('open');
    }

    // Raw markdown lives at /posts/<slug>.md (generated by posts/[slug].md.ts),
    // the same URL the pre-Astro site published, so existing links still resolve.
    // Labels come from data attributes because this script is bundled once for
    // every language.
    const btn = document.querySelector<HTMLButtonElement>('.copy-md-btn');
    const url = btn?.dataset['mdUrl'];
    if (btn && url) {
        const { label = 'copy md', labelCopied = 'copied!', labelFailed = 'failed', summaryPrompt } = btn.dataset;
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        btn.addEventListener('click', async () => {
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error(`http ${res.status}`);
                const md = await res.text();
                await navigator.clipboard?.writeText(summaryPrompt ? `${summaryPrompt}\n\n---\n\n${md}` : md);
                btn.textContent = labelCopied;
            } catch (err) {
                console.warn('Markdown could not be copied:', err);
                btn.textContent = labelFailed;
            }
            clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
                btn.textContent = label;
            }, 1500);
        });
    }
</script>
