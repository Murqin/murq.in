---
import Base from '../layouts/Base.astro';
import Controls from './Controls.astro';
import RssLink from './RssLink.astro';
import { LANGS, blogIndexUrl, getPosts, postSlug, postUrl, rssUrl, type Lang } from '../lib/blog';
import { formatPostDate } from '../lib/date';
import { ui } from '../lib/i18n';
import { ogImageUrl } from '../lib/ogPath';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const links = Object.fromEntries(LANGS.map((l) => [l, blogIndexUrl(l)]));
---

<Base
    title="Blog — Icarus Murqin"
    description={t.blogDescription}
    lang={lang}
    ogImagePath={ogImageUrl(lang, 'blog')}
    alternates={links}
    rssHref={rssUrl(lang)}
>
    <Controls lang={lang} links={links} />
    <section class="snap-page">
        <a href={t.homeUrl} class="blog-nav-link page-back bracket" data-seed-nav={t.homeUrl}>murq.in</a>
        <div class="page-head">
            <h1 class="snap-title">{t.blogHomeTitle}</h1>
            <RssLink lang={lang} />
        </div>
        <p class="snap-text">{t.blogDescription}</p>
        {
            posts.length === 0 ? (
                <p class="blog-empty">{t.noPosts}</p>
            ) : (
                <ul class="page-posts">
                    {posts.map((post) => {
                        const href = postUrl(lang, postSlug(post));
                        return (
                            <li>
                                <a href={href} data-seed-nav={href}>
                                    <span class="snap-post-date">{formatPostDate(post.data.date, lang)}</span>
                                    <span class="page-post-title">{post.data.title}</span>
                                    <span class="page-post-summary">{post.data.summary}</span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            )
        }
    </section>
</Base>
