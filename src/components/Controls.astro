---
import LangSwitch from './LangSwitch.astro';
import DiceIcon from './DiceIcon.astro';
import ThemeIcon from './ThemeIcon.astro';
import PlanetIcon from './PlanetIcon.astro';
import type { Lang } from '../lib/blog';
import { ui } from '../lib/i18n';

// Group page preferences and sky actions in one corner, with the sky actions below the language row.
interface Props {
    lang: Lang;
    links: Partial<Record<Lang, string>>;
}

const { lang, links } = Astro.props;
const t = ui[lang];
---

<div class="page-controls">
    <div class="page-controls-row">
        <button type="button" class="theme-btn" aria-label={t.themeLabel} data-light-label={t.lightThemeLabel} data-dark-label={t.darkThemeLabel}>
            <ThemeIcon />
        </button>
        <LangSwitch lang={lang} links={links} />
        <slot />
    </div>
    <div class="sky-controls">
        <button type="button" class="dice-btn" aria-label={t.diceLabel}>
            <DiceIcon />
        </button>
        <button type="button" class="seed-star" aria-label={t.seedLabel} data-copied={t.seedCopied}>
            <PlanetIcon />
        </button>
    </div>
</div>
