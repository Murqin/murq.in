---
import LangSwitch from './LangSwitch.astro';
import type { Lang } from '../lib/blog';
import { ui } from '../lib/i18n';

// Page controls (language) sit top-right; the sky's own controls (new random theme, copy seed) sit
// top-left, mirroring them, since they act on the background rather than the page. theme.ts finds
// the dice and seed buttons by class.
interface Props {
    lang: Lang;
    links: Partial<Record<Lang, string>>;
}

const { lang, links } = Astro.props;
const t = ui[lang];
---

<div class="page-controls">
    <LangSwitch lang={lang} links={links} />
    <slot />
</div>
<div class="sky-controls">
    <button type="button" class="dice-btn" aria-label={t.diceLabel}>
        <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="3" y="3" width="18" height="18" rx="1"></rect>
            <circle cx="8.5" cy="8.5" r="1" fill="currentColor"></circle>
            <circle cx="15.5" cy="8.5" r="1" fill="currentColor"></circle>
            <circle cx="12" cy="12" r="1" fill="currentColor"></circle>
            <circle cx="8.5" cy="15.5" r="1" fill="currentColor"></circle>
            <circle cx="15.5" cy="15.5" r="1" fill="currentColor"></circle>
        </svg>
    </button>
    <!-- A telescope reticle: the seed is this sky's coordinate, and the button copies its link. The
         four-point star it replaced is what every "generate with AI" button uses now. -->
    <button type="button" class="seed-star" aria-label={t.seedLabel} data-copied={t.seedCopied}>
        <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="6.5"></circle>
            <path d="M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4"></path>
            <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
    </button>
    <button type="button" class="theme-btn" aria-label={t.themeLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
        </svg>
    </button>
</div>
