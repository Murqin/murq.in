---
import Base from '../layouts/Base.astro';
import Controls from './Controls.astro';
import { LANGS, type Lang } from '../lib/blog';
import { formatPostDate } from '../lib/date';
import { ui } from '../lib/i18n';
import { ogImageUrl } from '../lib/ogPath';
import type { ListItem } from '../data/listItem';

// Shared by the slash pages (/now, /ai): a short labelled list that exists in both languages.
interface Props {
    lang: Lang;
    page: 'now' | 'ai' | 'colophon';
    items: ListItem[];
    updated: Date;
}

const { lang, page, items, updated } = Astro.props;
const t = ui[lang];
const pages = {
    now: (l: Lang) => ({ title: ui[l].nowTitle, intro: ui[l].nowIntro, url: ui[l].nowUrl }),
    ai: (l: Lang) => ({ title: ui[l].aiTitle, intro: ui[l].aiIntro, url: ui[l].aiUrl }),
    colophon: (l: Lang) => ({ title: ui[l].colophonTitle, intro: ui[l].colophonIntro, url: ui[l].colophonUrl }),
};
const { title, intro } = pages[page](lang);
const links = Object.fromEntries(LANGS.map((l) => [l, pages[page](l).url]));
// "ai" in a list item means this language's /ai page; anything else is a full URL.
const href = (target: string) => (target === 'ai' ? t.aiUrl : target);
---

<Base
    title={`${title} — Icarus Murqin`}
    description={intro}
    lang={lang}
    alternates={links}
    ogImagePath={ogImageUrl(lang, page)}
>
    <Controls lang={lang} links={links} />
    <section class="snap-page">
        <a href={t.homeUrl} class="blog-nav-link page-back" data-seed-nav={t.homeUrl}>← murq.in</a>
        <h1 class="snap-title">{title}</h1>
        <p class="snap-text">{intro}</p>
        <dl class="now-list">
            {
                items.map((item) => (
                    <div class="now-item">
                        <dt>{item.label[lang]}</dt>
                        <dd>
                            {item.text[lang]}
                            {item.links?.map((link) => {
                                const url = href(link.href);
                                const external = url.startsWith('http');
                                return (
                                    <>
                                        {' '}
                                        <a
                                            class="bracket"
                                            href={url}
                                            {...(external
                                                ? { target: '_blank', rel: 'noopener noreferrer' }
                                                : { 'data-seed-nav': url })}
                                        >
                                            {link.label[lang]}
                                        </a>
                                    </>
                                );
                            })}
                        </dd>
                    </div>
                ))
            }
        </dl>
        <p class="now-updated">{t.updated} {formatPostDate(updated, lang)}</p>
    </section>
</Base>
