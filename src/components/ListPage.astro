---
import Base from '../layouts/Base.astro';
import Controls from './Controls.astro';
import { LANGS, type Lang } from '../lib/blog';
import { formatPostDate } from '../lib/date';
import { ui } from '../lib/i18n';
import { ogImageUrl } from '../lib/ogPath';
import type { ListItem } from '../data/listItem';

// Shared by the slash pages (/now, /ai): a short labelled list that exists in both languages.
interface Props {
    lang: Lang;
    page: 'now' | 'ai';
    items: ListItem[];
    updated: Date;
}

const { lang, page, items, updated } = Astro.props;
const t = ui[lang];
const title = page === 'now' ? t.nowTitle : t.aiTitle;
const intro = page === 'now' ? t.nowIntro : t.aiIntro;
const links = Object.fromEntries(LANGS.map((l) => [l, page === 'now' ? ui[l].nowUrl : ui[l].aiUrl]));
---

<Base
    title={`${title} — Icarus Murqin`}
    description={intro}
    lang={lang}
    alternates={links}
    ogImagePath={ogImageUrl(lang, page)}
    here={title}
>
    <Controls lang={lang} links={links} />
    <section class="snap-page">
        <a href={t.homeUrl} class="blog-nav-link page-back" data-seed-nav={t.homeUrl}>← murq.in</a>
        <h1 class="snap-title">{title}</h1>
        <p class="snap-text">{intro}</p>
        <dl class="now-list">
            {
                items.map((item) => (
                    <div class="now-item">
                        <dt>{item.label[lang]}</dt>
                        <dd>{item.text[lang]}</dd>
                    </div>
                ))
            }
        </dl>
        <p class="now-updated">{t.updated} {formatPostDate(updated, lang)}</p>
    </section>
</Base>
